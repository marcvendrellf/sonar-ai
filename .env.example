# Sonar AI — environment example
#
# Copy to `apps/web/.env.local` (git-ignored) and fill in real values.
#
# RULES (see AGENTS.md / llm-wiki):
# - Every key here is SERVER-ONLY. Never expose one to the browser and never
#   prefix any of these with NEXT_PUBLIC_.
# - Alpaca credentials are PAPER-ONLY. Live trading is disabled in code.
# - The full demo must run offline from fixtures. Set SONAR_OFFLINE=true to force
#   the fixture-fallback path and make zero external calls.
# - Do NOT commit real keys. Only `.env.example` is tracked.

# ─────────────────────────────────────────────────────────────────────────────
# Runtime mode
# ─────────────────────────────────────────────────────────────────────────────

# Force the sanitized-fixture path for Cala, Alpaca, and the model layer.
# When true, no network calls are made — this is the offline demo path.
SONAR_OFFLINE=true

# ─────────────────────────────────────────────────────────────────────────────
# Agent model / runtime  (the 5 decision agents + Report Writer)
# ─────────────────────────────────────────────────────────────────────────────
# Provider: OpenAI for all agents (structured outputs + function/tool calling).

OPENAI_API_KEY=

# Optional: only set if using a non-default base URL (Azure OpenAI, a proxy,
# or an OpenAI-compatible gateway). Leave blank for api.openai.com.
OPENAI_BASE_URL=

# Optional: OpenAI organization / project scoping. Leave blank if unused.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Model id for the committee agents. Pick a current OpenAI model that supports
# structured outputs and tool calling; confirm the exact id against your account.
SONAR_AGENT_MODEL=gpt-5.6-luna

# Bounded call limits (keep committee runs deterministic and cheap).
SONAR_AGENT_MAX_TOKENS=4096
SONAR_AGENT_MAX_RETRIES=1
SONAR_AGENT_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Cala — evidence knowledge graph  (server-only)
# ─────────────────────────────────────────────────────────────────────────────

# Sent as the `X-API-KEY` request header (per the Cala capture).
CALA_API_KEY=

# MCP endpoint from the public capture. Override if the API base differs.
CALA_MCP_ENDPOINT=https://api.cala.ai/mcp/

# Optional: request timeout (ms) before falling back to the Cala fixture.
CALA_TIMEOUT_MS=15000

# ─────────────────────────────────────────────────────────────────────────────
# Alpaca Paper Trading — server-only
# ─────────────────────────────────────────────────────────────────────────────
# Use keys generated from the Alpaca Paper account. Endpoint is hard-coded in
# the server adapter as https://paper-api.alpaca.markets/v2.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_TIMEOUT_MS=15000
